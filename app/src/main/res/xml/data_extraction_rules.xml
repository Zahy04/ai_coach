<?xml version="1.0" encoding="utf-8"?>
<!--
    Žádná data neopouštějí zařízení přes zálohy: DataStore drží API klíče a GitHub
    token v otevřené podobě, databáze zdravotní údaje a složky fotky postavy.
    allowBackup="false" vypíná cloudovou zálohu; tato pravidla (Android 12+)
    vylučují i přenos mezi zařízeními.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
